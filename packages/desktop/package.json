{
  "name": "@own-harness/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.extensions.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src test extensions/*/src",
    "coverage": "vitest run --coverage --passWithNoTests --coverage.include=\"src/**/*.ts\" --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.branches=60 --coverage.thresholds.statements=80"
  },
  "dependencies": {
    "@own-harness/contracts": "workspace:*",
    "@own-harness/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
